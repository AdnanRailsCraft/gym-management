{
  "name": "gym-management-system",
  "productName": "GymManagementSystem",
  "version": "0.0.1",
  "private": true,
  "description": "Offline desktop gym management system (Empire Fitness)",
  "author": "Empire Fitness",
  "license": "UNLICENSED",
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=22.23.0 <23"
  },
  "scripts": {
    "dev": "cross-env NEXT_TELEMETRY_DISABLED=1 next dev",
    "dev:electron": "npm run build:electron && cross-env NEXT_TELEMETRY_DISABLED=1 GMS_DEV=1 electron .",
    "build": "cross-env NEXT_TELEMETRY_DISABLED=1 next build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:migrate": "cross-env NEXT_TELEMETRY_DISABLED=1 tsx scripts/db-migrate.ts",
    "db:seed": "node scripts/db-seed.mjs",
    "db:generate": "node scripts/db-generate.mjs",
    "rebuild:node": "npm rebuild better-sqlite3",
    "rebuild:electron": "electron-builder install-app-deps",
    "package": "npm run build && npm run build:electron && electron-builder install-app-deps && node scripts/prepare-standalone.mjs && electron-builder --win nsis && node scripts/checksums.mjs",
    "package:dir": "npm run build && npm run build:electron && electron-builder install-app-deps && node scripts/prepare-standalone.mjs && electron-builder --dir"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cross-env": "10.1.0",
    "electron": "44.8.0",
    "electron-builder": "26.15.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "playwright": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
